{
  "name": "whatsapp-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API WhatsApp self-hosted berbasis Baileys, drop-in replacement untuk gateway Fonnte pada Sistem Informasi Manajemen Laundry",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:send": "node scripts/send-message.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mysql2": "3.24.6",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
