# ==========================================================
# Salin file ini menjadi `.env`, lalu sesuaikan nilainya.
# JANGAN commit file `.env` yang berisi nilai asli.
# ==========================================================

# --- Alamat HTTP gateway ---
# 127.0.0.1 = hanya bisa diakses dari komputer ini (aman untuk development).
# Ubah ke 0.0.0.0 HANYA jika gateway memang perlu diakses dari mesin lain.
HOST="127.0.0.1"
PORT="3001"

# --- API key ---
# Nilai ini harus SAMA dengan FONNTE_TOKEN di aplikasi laundry.
# Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY="ganti-dengan-api-key-acak-minimal-32-karakter"

# --- Sesi WhatsApp ---
# Direktori penyimpanan sesi login (hasilkan dari scan QR). Jangan di-commit.
SESSION_DIR="auth_state"

# --- Log Baileys ---
# silent | error | warn | info | debug
LOG_LEVEL="warn"

# --- Mode simulasi ---
# true  = tidak menyentuh WhatsApp sama sekali; pengiriman disimulasikan.
#         Berguna untuk menguji integrasi aplikasi laundry sebelum scan QR.
# false = terhubung ke WhatsApp sungguhan (butuh scan QR).
MOCK_MODE="false"

# --- Balasan otomatis untuk chat masuk ---
# Menggantikan "welcome message" yang dulu ditangani gateway pihak ketiga.
# Satu nomor pengirim hanya mendapat SATU balasan otomatis per hari (reset 00:00 WIB).
AUTO_REPLY_ENABLED="true"
# Template balasan. Variabel yang didukung: {{name}} (nama pengirim) dan {{date}}.
# Placeholder lain dibiarkan apa adanya dan TIDAK pernah dievaluasi sebagai kode.
AUTO_REPLY_MESSAGE="Terima kasih telah menghubungi Zahra Laundry. Pesan Anda sudah kami terima dan admin akan segera membalas. Mohon tunggu ya."
# Jeda sebelum balasan dikirim (milidetik). 0 = langsung. Default 3000 (3 detik).
AUTO_REPLY_DELAY_MS="3000"
# --- Database ---
# Gunakan kredensial database yang SAMA dengan aplikasi laundry.
# Riwayat balasan otomatis disimpan di tabel `auto_reply_logs`, yang dibuat oleh
# migrasi Prisma di aplikasi laundry (jalankan: npx prisma migrate deploy).
DATABASE_URL="mysql://root:ganti-password@127.0.0.1:3306/laundry_db"

# --- Nilai bantu untuk `npm run test:send` ---
# Nomor WhatsApp tujuan uji dalam format 62xxxx.
TEST_TARGET=""
# Alamat gateway; biasanya tidak perlu diubah.
GATEWAY_URL="http://127.0.0.1:3001"
